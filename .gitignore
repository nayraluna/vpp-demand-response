# ==========================================================================
# SECRETS: deny by pattern, everywhere, not by path.
# Path-scoped rules only protect the directory you thought of. These also
# catch a key written somewhere new. Nothing in this repository is generated
# by anyone but the person running it: `provision_all.py` builds the whole
# PKI locally, so no certificate or key of any kind is committed.
# ==========================================================================
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.csr
*.srl
*.der
*.crt
*.cer
certs/*.ext
.env
.env.*
!.env.example
secrets.*
credentials.*

# Third-party SDK binary, not ours to redistribute. The FNMT DNIeDroid .aar is
# signed by CNP-FNMT and ships under its own terms, so it is obtained from the
# FNMT rather than committed here. See the Android section of the README.
android-app/app/libs/*.aar

# Exceptions: public trust anchors the Android app must ship with in order to
# build. The DNIe root is published by the Spanish national police. The local
# CA root is a development anchor regenerated by provision_all.py.
!android-app/app/src/main/res/raw/ac_raiz_dnie2.crt
!android-app/app/src/main/res/raw/ca.crt

# Runtime state, regenerated on every start
*.db
*.sqlite
*.sqlite3
*.log

# Appliance runtime config (auto-created from the factory defaults in config.py,
# and pairing mutates it, so it is per-deployment state, not source)
appliance/config.json

# Documents kept in the working tree for reference but never published. The
# thesis write-up carries personal data and is not part of the source, so this
# denies by pattern like the secrets block above rather than naming one file.
*.pdf

# Editor
.vscode/

# Python
__pycache__/
*.py[cod]
.venv
venv/
env/
