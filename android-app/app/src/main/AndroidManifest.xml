<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- The DNIe is read over NFC; the rest of the app runs on devices without it. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Cleartext: the appliance's pairing service (:8082) is plain HTTP on the
         local network; its security rests on the signed artefacts it carries. -->
    <application
        android:name=".TfgVppApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TfgVpp">

        <!-- Single Activity: every screen is a Compose destination. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The one exception: the FNMT DNIe SDK requires NFC reader mode and
             its own PIN dialog, so the DNIe login keeps its own Activity and
             returns the proven identity as an ActivityResult. -->
        <activity
            android:name=".DnieLoginActivity"
            android:exported="false" />
    </application>

</manifest>
