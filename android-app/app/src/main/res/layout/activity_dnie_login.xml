<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows: this screen is Views, not Compose, so nothing insets it
     the way Scaffold does and the title would sit under the status bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnie_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnie_can_label"
        android:textSize="12sp"
        android:paddingBottom="8dp" />

    <!-- Six visual cells with an invisible EditText overlaid on top: the
         EditText owns the input and the keyboard; the cells just render it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/canCells"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView style="@style/CanCell" />
            <TextView style="@style/CanCell" />
            <TextView style="@style/CanCell" />
            <TextView style="@style/CanCell" />
            <TextView style="@style/CanCell" />
            <TextView style="@style/CanCell" />
        </LinearLayout>

        <EditText
            android:id="@+id/canInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:textColor="@android:color/transparent"
            android:cursorVisible="false"
            android:inputType="number"
            android:maxLength="6"
            android:importantForAutofill="no"
            android:autofillHints="" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:text="@string/dnie_status_initial" />

    <Button
        android:id="@+id/btnUseIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:text="@string/dnie_use_identity" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />
    </ScrollView>
</LinearLayout>
